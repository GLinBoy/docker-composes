# Home Assistant Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGE (application — exact-pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
HOME_ASSISTANT_IMAGE=homeassistant/home-assistant:2026.8.1

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
# Set to your local timezone (e.g. Europe/Amsterdam, America/New_York)
HOME_ASSISTANT_TZ=UTC
