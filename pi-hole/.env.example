# Pi-hole Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGE (application — exact-pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
PIHOLE_IMAGE=pihole/pihole:2026.07.2

# =============================================================================
# Web interface password (Pi-hole v6: FTLCONF_webserver_api_password)
# SERVER: set a strong password before exposing beyond localhost —
# generate with: openssl rand -hex 32
# WARNING: leaving this empty DISABLES the web interface password entirely
# =============================================================================
PIHOLE_WEBPASSWORD=

# =============================================================================
# Ports
# =============================================================================
# Host ports mapped to the container's DNS (53), web (80) and DHCP (67) ports
PIHOLE_DNS_PORT=53
PIHOLE_WEB_PORT=80
# PIHOLE_DHCP_PORT=67

# =============================================================================
# Timezone (UTC by default per repo convention)
# =============================================================================
PIHOLE_TZ=UTC
