# OpenClaw Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGE (optional — override to pin a specific release)
# =============================================================================
# OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# =============================================================================
# Gateway Authentication
# =============================================================================
# Generate a strong token: openssl rand -hex 32
# Leave blank to auto-generate on first start (NOT recommended for production)
OPENCLAW_GATEWAY_TOKEN=

# Optional: Bind address — use "localhost" to restrict to local machine only
# Default is "lan" (accessible on your local network)
# OPENCLAW_GATEWAY_BIND=lan

# =============================================================================
# Gateway Ports
# =============================================================================
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_MSTEAMS_PORT=3978

# =============================================================================
# Host-side data directories (auto-detected from $HOME if left blank)
# =============================================================================
# OPENCLAW_CONFIG_DIR=~/.openclaw
# OPENCLAW_WORKSPACE_DIR=~/.openclaw/workspace
# OPENCLAW_AUTH_PROFILE_SECRET_DIR=~/.openclaw-auth-profile-secrets

# =============================================================================
# Timezone
# =============================================================================
OPENCLAW_TZ=UTC

# =============================================================================
# Model Provider API Keys (set at least one)
# =============================================================================
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...

# =============================================================================
# Optional Model Providers
# =============================================================================
# ZAI_API_KEY=...
# AI_GATEWAY_API_KEY=...
# TOKENHUB_API_KEY=...
# LKEAP_API_KEY=...
# MINIMAX_API_KEY=...
# SYNTHETIC_API_KEY=...

# =============================================================================
# Messaging Channel Tokens (only set what you enable)
# =============================================================================
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# MATTERMOST_BOT_TOKEN=...
# MATTERMOST_URL=https://chat.example.com
# ZALO_BOT_TOKEN=...
# OPENCLAW_TWITCH_ACCESS_TOKEN=oauth:...

# =============================================================================
# Voice / Media Tools (optional)
# =============================================================================
# BRAVE_API_KEY=...
# PERPLEXITY_API_KEY=pplx-...
# FIRECRAWL_API_KEY=...
# ELEVENLABS_API_KEY=...
# DEEPGRAM_API_KEY=...

# =============================================================================
# OpenTelemetry (optional)
# =============================================================================
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=openclaw

# =============================================================================
# Advanced Options
# =============================================================================
# OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=
# OPENCLAW_DISABLE_BONJOUR=
# OPENCLAW_INCLUDE_ROOTS=/etc/openclaw/shared
# OPENCLAW_LOAD_SHELL_ENV=1
# OPENCLAW_SHELL_ENV_TIMEOUT_MS=15000

# =============================================================================
# Sandbox Support (SERVER only)
# =============================================================================
# Set to host's docker group GID: stat -c '%g' /var/run/docker.sock
# DOCKER_GID=999
