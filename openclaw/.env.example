# OpenClaw Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGE (application — exact-pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1-2

# =============================================================================
# GATEWAY AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -hex 32
# Leave blank to auto-generate on first start (NOT recommended for production)
OPENCLAW_GATEWAY_TOKEN=

# Bind address for the gateway inside the container: "lan" (default, reachable
# on your local network) or "localhost" (local machine only)
OPENCLAW_GATEWAY_BIND=lan

# =============================================================================
# GATEWAY PORTS (host side; container ports are fixed)
# Bound to 127.0.0.1 by default (LOCAL). SERVER: keep behind a reverse proxy or
# expose deliberately (e.g. bind to 0.0.0.0 for LAN access).
# =============================================================================
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_MSTEAMS_PORT=3978

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
OPENCLAW_TZ=UTC

# =============================================================================
# MODEL PROVIDER API KEYS (set at least one)
# Passed through to the containers via the env_file directive in docker-compose.yml
# =============================================================================
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...

# =============================================================================
# OPTIONAL MODEL PROVIDERS
# =============================================================================
# ZAI_API_KEY=...
# AI_GATEWAY_API_KEY=...
# TOKENHUB_API_KEY=...
# LKEAP_API_KEY=...
# MINIMAX_API_KEY=...
# SYNTHETIC_API_KEY=...

# =============================================================================
# MESSAGING CHANNEL TOKENS (only set what you enable)
# =============================================================================
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# MATTERMOST_BOT_TOKEN=...
# MATTERMOST_URL=https://chat.example.com
# ZALO_BOT_TOKEN=...
# OPENCLAW_TWITCH_ACCESS_TOKEN=oauth:...

# =============================================================================
# VOICE / MEDIA TOOLS (optional)
# =============================================================================
# BRAVE_API_KEY=...
# PERPLEXITY_API_KEY=pplx-...
# FIRECRAWL_API_KEY=...
# ELEVENLABS_API_KEY=...
# DEEPGRAM_API_KEY=...

# =============================================================================
# OPENTELEMETRY (optional)
# =============================================================================
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=openclaw

# =============================================================================
# ADVANCED OPTIONS
# =============================================================================
# OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=
# OPENCLAW_DISABLE_BONJOUR=
# OPENCLAW_INCLUDE_ROOTS=/etc/openclaw/shared
# OPENCLAW_LOAD_SHELL_ENV=1
# OPENCLAW_SHELL_ENV_TIMEOUT_MS=15000

# =============================================================================
# SANDBOX SUPPORT (SERVER only)
# =============================================================================
# Set to the host docker group GID: stat -c '%g' /var/run/docker.sock
# DOCKER_GID=999
