# MongoDB Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# Database
# =============================================================================

# Root admin username for MongoDB
MONGO_ROOT_USER=root

# Root admin password for MongoDB — generate with: openssl rand -hex 32
MONGO_ROOT_PASSWORD=

# Login for the mongo-express web UI
MONGOEXPRESS_LOGIN=admin

# Password for the mongo-express web UI — generate with: openssl rand -hex 32
MONGOEXPRESS_PASSWORD=

# Timezone (default: UTC)
TZ=Etc/UTC

# Host port for MongoDB (default: 27017)
MONGO_PORT=27017

# Host port for the mongo-express web UI (default: 8081)
MONGO_EXPRESS_PORT=8081

# =============================================================================
# Exact dependency images — never `latest`
# To update, bump the exact value, then re-run docker compose up -d
# =============================================================================

MONGO_IMAGE=mongo:8.2.12
MONGO_EXPRESS_IMAGE=mongo-express:1.0.2-20-alpine3.19
