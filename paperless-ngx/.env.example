# Paperless-NGX Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image (exact-pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the image
PAPERLESS_NGX_IMAGE=paperlessngx/paperless-ngx:3.0.5

# Dependency images (exact-pinned so an accidental upgrade can't break the stack)
PAPERLESS_REDIS_IMAGE=redis:7.4.11-alpine
PAPERLESS_POSTGRES_IMAGE=postgres:16.15-alpine

# =============================================================================
# Ports
# =============================================================================
# Host port mapped to the container's web UI port 8000
PAPERLESS_NGX_PORT=8000

# =============================================================================
# User / Group IDs (runs paperless in the container as this user)
# =============================================================================
# Find your UID/GID with `id -u` / `id -g`; must match the owner of the
# consume/export directories so you have write access
USERMAP_UID=1000
USERMAP_GID=1000

# =============================================================================
# PostgreSQL (required)
# =============================================================================
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=   # generate with: openssl rand -hex 32

# =============================================================================
# Application (required)
# =============================================================================
# Unique secret key for session tokens and signing
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=

# =============================================================================
# Optional settings
# =============================================================================
# Public URL of your paperless-ngx instance (e.g. https://paperless.example.com)
PAPERLESS_URL=http://localhost:8000
# Timezone (UTC by default per repo convention)
PAPERLESS_TIME_ZONE=UTC
# Default OCR language (3-letter code, e.g. deu, fra, eng+deu)
PAPERLESS_OCR_LANGUAGE=eng
