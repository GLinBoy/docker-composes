# NATS Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGE (application — exact-pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
NATS_IMAGE=nats:2.14.4-alpine3.22

# =============================================================================
# Cluster
# =============================================================================
# Cluster name shared by all nodes
NATS_CLUSTER_NAME=NATS

# =============================================================================
# Ports (host side; container ports are fixed)
# =============================================================================
# NATS client connections (master node) — default 4222
NATS_PORT_CLIENT_0=4222
# HTTP monitoring / healthz (master node) — default 8222
NATS_PORT_MONITOR_0=8222
# NATS client connections (slave node) — default 4223
NATS_PORT_CLIENT_1=4223
# HTTP monitoring / healthz (slave node) — default 8223
NATS_PORT_MONITOR_1=8223
