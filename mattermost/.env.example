# Mattermost Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose
# Bump this value and re-run `docker compose up -d` to update the image
# Use mattermost-enterprise-edition (free E0 license) or mattermost-team-edition (free, no E0)
MATTERMOST_IMAGE=mattermost/mattermost-enterprise-edition:11.7.0

# Dependency image (exact-pinned, never latest)
MATTERMOST_POSTGRES_IMAGE=postgres:18-alpine

# =============================================================================
# SECRETS (REQUIRED — fill these in)
# =============================================================================
# PostgreSQL password
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=mmuser
POSTGRES_DB=mattermost

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the Mattermost web UI (container port is always 8065)
MATTERMOST_PORT=8065

# Public site URL — set to your real domain (e.g. https://chat.example.com)
# when exposing Mattermost behind a reverse proxy
MATTERMOST_SITE_URL=http://localhost:8065

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
MATTERMOST_TZ=UTC
