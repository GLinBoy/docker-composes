# Nginx Proxy Manager Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update the image.
NPM_VERSION=2.15.1

# Dependency image — exact-pinned (never latest).
NPM_DB_IMAGE=docker.io/postgres:17-alpine

# =============================================================================
# APPLICATION
# =============================================================================
# Timezone (default: UTC)
TZ=Etc/UTC

# Host port for the admin web UI (container port is fixed: 81)
NPM_ADMIN_PORT=81

# Host port for public HTTP (container port is fixed: 80)
NPM_HTTP_PORT=80

# Host port for public HTTPS (container port is fixed: 443)
NPM_HTTPS_PORT=443

# =============================================================================
# DATABASE
# =============================================================================
NPM_DB_USER=npm
NPM_DB_NAME=npm
# Generate with: openssl rand -hex 24
NPM_DB_PASSWORD=
