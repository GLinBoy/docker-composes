# NetBox Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update the image.
NETBOX_VERSION=v4.6.8-5.0.2

# Dependency images — exact-pinned (never latest).
NETBOX_DB_IMAGE=docker.io/postgres:17.11-alpine
NETBOX_REDIS_IMAGE=docker.io/valkey/valkey:8.1-alpine

# =============================================================================
# APPLICATION
# =============================================================================
# Timezone (default: UTC)
TZ=Etc/UTC

# Host port for the NetBox web UI (container port is fixed: 8080)
NETBOX_PORT=8000

# Django secret key — generate with: openssl rand -hex 50
NETBOX_SECRET_KEY=

# Set to true to skip automatic superuser creation (recommended for upgrades).
# Set to false and fill in the SUPERUSER_* values to create the admin on first start.
NETBOX_SKIP_SUPERUSER=true
NETBOX_SUPERUSER_EMAIL=
NETBOX_SUPERUSER_PASSWORD=
NETBOX_SUPERUSER_API_TOKEN=

# =============================================================================
# DATABASE
# =============================================================================
NETBOX_DB_NAME=netbox
NETBOX_DB_USER=netbox
# Generate with: openssl rand -hex 24
NETBOX_DB_PASSWORD=

# =============================================================================
# REDIS
# =============================================================================
# Main Redis (queues)
# Generate with: openssl rand -hex 24
NETBOX_REDIS_PASSWORD=
# Cache Redis — use a different value than the main Redis password
# Generate with: openssl rand -hex 24
NETBOX_REDIS_CACHE_PASSWORD=

# =============================================================================
# FEATURES (optional)
# =============================================================================
NETBOX_GRAPHQL_ENABLED=true
NETBOX_METRICS_ENABLED=false
NETBOX_WEBHOOKS_ENABLED=true
NETBOX_CORS_ORIGIN_ALLOW_ALL=false
# Generate with: openssl rand -hex 24
NETBOX_API_TOKEN_PEPPER_1=
NETBOX_RELEASE_CHECK_URL=https://api.github.com/repos/netbox-community/netbox/releases

# =============================================================================
# EMAIL (optional)
# =============================================================================
NETBOX_EMAIL_SERVER=localhost
NETBOX_EMAIL_PORT=25
NETBOX_EMAIL_USERNAME=netbox
NETBOX_EMAIL_PASSWORD=
NETBOX_EMAIL_USE_SSL=false
NETBOX_EMAIL_USE_TLS=false
NETBOX_EMAIL_TIMEOUT=5
NETBOX_EMAIL_FROM=netbox@localhost
