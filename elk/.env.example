# ELK Stack Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Elastic Stack version — Elasticsearch, Logstash and Kibana are released in
# lockstep, so one variable pins all three. Exact-pinned in .env, defaults to
# latest in compose. Bump this value and re-run docker compose up -d to update.
ELK_VERSION=9.5.1

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the Elasticsearch HTTP API (bound to loopback only by default)
ELASTICSEARCH_PORT=9200

# Logstash input ports (container ports are fixed: 12201/udp, 5044, 5000)
LOGSTASH_GELF_PORT=12201
LOGSTASH_BEATS_PORT=5044
LOGSTASH_TCP_PORT=5000

# Host port for the Kibana web UI (container port is always 5601)
KIBANA_PORT=5601

# Public base URL Kibana uses to build links — set to your domain on the server
KIBANA_PUBLICBASEURL=http://localhost:5601

# JVM heap for Elasticsearch and Logstash.
# SERVER: Set ES heap to half of your server's available RAM (e.g. -Xms4g -Xmx4g for 8 GB)
ES_JAVA_OPTS=-Xms512m -Xmx512m
LS_JAVA_OPTS=-Xms256m -Xmx256m

# Kibana encryption keys — must each be at least 32 characters.
# Generate real values with: openssl rand -hex 32   (run once per key)
XPACK_SECURITY_ENCRYPTIONKEY=changeme-encryption-key-00000000000000000000000000
XPACK_REPORTING_ENCRYPTIONKEY=changeme-reporting-key-00000000000000000000000000
XPACK_ENCRYPTEDSAVEDOBJECTS_ENCRYPTIONKEY=changeme-saved-objects-key-00000000000000000000

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
ELK_TZ=UTC
