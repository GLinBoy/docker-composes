# BookStack Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# Application
# =============================================================================

# The exact BookStack version to deploy (e.g. 26.05.3) — compose defaults to `latest` when unset
# To update, bump this value to the next release, then re-run docker compose up -d
BOOKSTACK_VERSION=26.05.3

# Exact dependency image — never `latest`
# To update, bump the exact value, then re-run docker compose up -d
BOOKSTACK_DATABASE_IMAGE=mariadb:11.8.8

# Host port for the web UI (default: 6875)
BOOKSTACK_PORT=6875

# Public URL of the installation (used for links and CSRF)
# SERVER: set to your real domain (e.g. https://bookstack.example.com)
APP_URL=http://localhost:6875

# Session encryption key — REQUIRED, the container halts without it.
# Generate with: docker run -it --rm --entrypoint /bin/bash lscr.io/linuxserver/bookstack:latest appkey
APP_KEY=

# User/group ID the container processes run as — set to your host user's id (`id -u` / `id -g`)
PUID=1000
PGID=1000

# Timezone (default: UTC)
TZ=Etc/UTC

# Set to "database" to enable async actions (e.g. sending email, triggering webhooks)
# Empty = disabled (default)
QUEUE_CONNECTION=

# =============================================================================
# Database
# =============================================================================

# Database name and user
DB_DATABASE=bookstackapp
DB_USERNAME=bookstack

# Connection secret for the BookStack app — alphanumeric characters only.
# Generate with: head /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 24 && echo
DB_PASSWORD=

# Root password for the MariaDB server (backups, maintenance) — alphanumeric only
DB_ROOT_PASSWORD=
