# Hermes Agent Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGE (optional — override to pin a specific release)
# =============================================================================
# HERMES_IMAGE=nousresearch/hermes-agent:latest

# =============================================================================
# User/Group IDs (Required for file permissions)
# =============================================================================
# Set to your host user's UID/GID so files stay readable/writable
# Run: echo "HERMES_UID=$(id -u)" && echo "HERMES_GID=$(id -g)"
HERMES_UID=10000
HERMES_GID=10000

# =============================================================================
# Data Directory (optional — defaults to ~/.hermes)
# =============================================================================
# SERVER: Set an absolute path for easier backup control
# HERMES_DATA_DIR=/data/hermes

# =============================================================================
# LLM Provider API Keys (set at least one)
# =============================================================================
# OpenRouter - 200+ models through one API (recommended)
# Get at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# NovitaAI - 90+ models, pay-per-use
# Get at: https://novita.ai/settings/key-management
NOVITA_API_KEY=

# Google AI Studio / Gemini
# Get at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Ollama Cloud
# Get at: https://ollama.com/settings
OLLAMA_API_KEY=

# z.ai / GLM
# Get at: https://z.ai or https://open.bigmodel.cn
GLM_API_KEY=

# Kimi / Moonshot
# Get at: https://platform.kimi.ai
KIMI_API_KEY=

# Arcee AI (Trinity models)
# Get at: https://chat.arcee.ai/
ARCEEAI_API_KEY=

# MiniMax
# Get at: https://www.minimax.io
MINIMAX_API_KEY=

# OpenCode Zen
# Get at: https://opencode.ai/auth
OPENCODE_ZEN_API_KEY=

# OpenCode Go ($10/month)
# Get at: https://opencode.ai/auth
OPENCODE_GO_API_KEY=

# Hugging Face Inference Providers
# Get at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Xiaomi MiMo
# Get at: https://platform.xiaomimimo.com
XIAOMI_API_KEY=

# =============================================================================
# Tool API Keys (Optional)
# =============================================================================
# Exa - AI-native web search
# Get at: https://exa.ai
EXA_API_KEY=

# Parallel - AI-native web search and extract
# Get at: https://parallel.ai
PARALLEL_API_KEY=

# Firecrawl - Web search, extract, and crawl
# Get at: https://firecrawl.dev/
FIRECRAWL_API_KEY=

# FAL.ai - Image generation
# Get at: https://fal.ai/
FAL_KEY=

# Browserbase - Cloud browser execution
# Get at: https://browserbase.com/
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# OpenAI - Voice transcription and TTS
# Get at: https://platform.openai.com/api-keys
VOICE_TOOLS_OPENAI_KEY=

# =============================================================================
# Messaging Platform Tokens (Optional - enable only what you use)
# =============================================================================
# Slack
# Get at: https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Telegram
# Get from @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Microsoft Teams
# Register at: https://dev.botframework.com/
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=

# Google Chat
# Setup: https://console.cloud.google.com/apis/credentials
GOOGLE_CHAT_PROJECT_ID=
GOOGLE_CHAT_SUBSCRIPTION_NAME=
# SERVER: Path to service account JSON (mount separately, don't put path here)
GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=

# =============================================================================
# Configuration (Optional)
# =============================================================================
TERMINAL_TIMEOUT=60
TERMINAL_LIFETIME_SECONDS=300
BROWSERBASE_PROXIES=true
BROWSER_INACTIVITY_TIMEOUT=120

# =============================================================================
# Advanced Options
# =============================================================================
# Groq - Free tier for Whisper STT
# Get at: https://console.groq.com/keys
# GROQ_API_KEY=

# GitHub - Higher rate limits for skill search
# Get at: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_...

# Honcho - Cross-session user modeling
# Get at: https://app.honcho.dev
# HONCHO_API_KEY=

# =============================================================================
# SERVER: API Server (expose OpenAI-compatible API beyond localhost)
# =============================================================================
# Uncomment BOTH lines — never set HOST without a KEY
# API_SERVER_KEY=   # Generate with: openssl rand -hex 32
# API_SERVER_HOST=0.0.0.0

# =============================================================================
# SERVER: Docker Group ID (for sandbox isolation via Docker socket)
# =============================================================================
# Run: stat -c '%g' /var/run/docker.sock
# DOCKER_GID=999
