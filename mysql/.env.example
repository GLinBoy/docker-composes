# MySQL Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGE (dependency — exact-pinned in both .env and compose)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
MYSQL_IMAGE=mysql:26.7.0

# =============================================================================
# Credentials
# =============================================================================
# SERVER: set a strong root password before exposing beyond localhost —
# generate with: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=
# Database created automatically on first start
MYSQL_DATABASE=sandbox
# Optional application user (leave empty to skip creation — only root is created)
MYSQL_USER=
MYSQL_PASSWORD=

# =============================================================================
# Ports (host side; container port is fixed)
# =============================================================================
MYSQL_PORT=3306

# =============================================================================
# Timezone (UTC by default per repo convention)
# =============================================================================
MYSQL_TZ=UTC
