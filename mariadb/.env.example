# MariaDB Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# Database
# =============================================================================

# Root password for the MariaDB server (backups, maintenance) — generate with: openssl rand -hex 32
MARIADB_ROOT_PASSWORD=

# Database name and user created on first start
MARIADB_DATABASE=mariadb
MARIADB_USER=mariadb

# Password for MARIADB_USER — generate with: openssl rand -hex 32
MARIADB_PASSWORD=

# Timezone (default: UTC)
TZ=Etc/UTC

# Host port for MySQL/MariaDB clients (default: 3306)
MARIADB_PORT=3306

# =============================================================================
# Exact dependency image — never `latest`
# To update, bump the exact value, then re-run docker compose up -d
# =============================================================================

MARIADB_IMAGE=mariadb:12.3.2
