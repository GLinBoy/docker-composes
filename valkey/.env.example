# Valkey Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGE (exact version pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
VALKEY_IMAGE=valkey/valkey:9.1.1-alpine3.24

# =============================================================================
# Password (optional)
# =============================================================================
# Leave empty for no password (local dev). SERVER: set a strong password before
# exposing beyond localhost — generate with: openssl rand -hex 32
VALKEY_PASSWORD=

# =============================================================================
# Timezone (UTC by default per repo convention)
# =============================================================================
TZ=UTC

# =============================================================================
# Ports (host side; container port is fixed)
# =============================================================================
# SERVER: Do not expose 6379 to the public internet
VALKEY_PORT=6379