# Keycloak Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update the image.
KEYCLOAK_VERSION=26.7.3

# =============================================================================
# APPLICATION
# =============================================================================
# Admin console bootstrap user (created on first start)
KEYCLOAK_ADMIN=admin

# Admin console bootstrap password — SERVER: use a strong value in production,
# e.g. generated with: openssl rand -base64 24 | tr -d '\n'
KEYCLOAK_ADMIN_PASSWORD=admin

# Host port for the Keycloak web UI / auth entry point (container port is fixed: 8080)
KEYCLOAK_PORT=8080

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
KEYCLOAK_TZ=UTC
