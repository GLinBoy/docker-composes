# Wiki.js Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Upstream recommends a floating MAJOR.MINOR tag (e.g. 2.5) so you keep getting
# the latest patch releases. Bump to a newer major/minor when released:
#   https://github.com/requarks/wiki/releases
WIKIJS_IMAGE=ghcr.io/requarks/wiki:2.5

# Exact dependency image — never `latest` (prefer Alpine variants)
POSTGRES_IMAGE=postgres:15-alpine

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the Wiki.js web UI (container port is fixed: 3000)
WIKIJS_PORT=3000

# =============================================================================
# DATABASE
# =============================================================================
# Database name and user created by the postgres image on first start
WIKIJS_DB_NAME=wiki
WIKIJS_DB_USER=wikijs

# Connection password for the wiki app — REQUIRED, the container halts without it.
# Generate with: openssl rand -hex 32
WIKIJS_DB_PASSWORD=

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
TZ=UTC