# Traefik Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Proxy image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update the image.
TRAEFIK_VERSION=3.7.10

# Demo service image (whoami) — exact-pinned in .env, defaults to latest in compose.
WHOAMI_VERSION=v1.12.0

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the web entrypoint — the public HTTP traffic port (container: 80)
TRAEFIK_HTTP_PORT=80

# Host port for the dashboard / API / ping endpoint (container: 8080)
# SERVER: The dashboard is unauthenticated (api.insecure) — do not expose this
# port to the internet in production (see README.md "Secure the Dashboard")
TRAEFIK_DASHBOARD_PORT=8080

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
TRAEFIK_TZ=UTC