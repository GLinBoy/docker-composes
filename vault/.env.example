# Vault Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update the image.
VAULT_VERSION=2.0.4

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the Vault HTTP API / Web UI (container port is fixed: 8200)
VAULT_PORT=8200

# =============================================================================
# DEV SERVER (this stack runs Vault in dev mode)
# =============================================================================
# SERVER: Plain-text root token for the dev server — LOCAL USE ONLY, never
# reuse on a real server (production initializes with `vault operator init`).
# Leave empty to have Vault generate a random token instead (printed in logs).
VAULT_DEV_ROOT_TOKEN_ID=vault-plaintext-root-token