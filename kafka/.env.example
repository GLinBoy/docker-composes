# Kafka Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# --- Kafka Broker ---
KAFKA_HOST=                # Hostname for external client connections (default: localhost)
KAFKA_PORT=                # Kafka broker port (default: 9092)

# --- Kafka UI ---
KAFKA_UI_PORT=             # Kafka UI web port (default: 9093)
