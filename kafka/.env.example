# Kafka Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application images — exact-pinned in .env, default to latest in compose.
# Bump these values and re-run `docker compose up -d` to update the stack.
KAFKA_VERSION=4.3.1
KAFKA_UI_VERSION=v0.7.2

# =============================================================================
# APPLICATION
# =============================================================================
# Hostname or IP advertised to external (non-container) clients.
# Use "localhost" for local development, or your host IP/hostname when
# connecting from other machines.
KAFKA_HOST=localhost

# Host port for Kafka client connections (container port stays fixed via env)
KAFKA_PORT=9092

# Host port for the Kafka UI web interface (container port is fixed: 8080)
KAFKA_UI_PORT=9093

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
KAFKA_TZ=UTC
KAFKA_UI_TZ=UTC