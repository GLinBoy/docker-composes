# Gotify Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGE (application — exact-pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
GOTIFY_IMAGE=gotify/server:3.0.0

# =============================================================================
# Ports
# =============================================================================
# Host port mapped to the container's HTTP port 80
GOTIFY_PORT=8080

# =============================================================================
# Initial admin account (only applied when the database is first created)
# =============================================================================
# SERVER: set a strong password before first start (openssl rand -hex 32), or
# change it immediately in the WebUI after first login. If unset, Gotify falls
# back to the default admin/admin.
# GOTIFY_DEFAULTUSER_NAME=admin
# GOTIFY_DEFAULTUSER_PASS=changeme

# =============================================================================
# Security / registration
# =============================================================================
# Allow anyone to register new user accounts via the public endpoint
# (default false — Gotify 3.x disables public registration by default)
GOTIFY_REGISTRATION=false

# =============================================================================
# Logging (trace, debug, info, warn, error, fatal, panic)
# =============================================================================
GOTIFY_LOGLEVEL=info

# =============================================================================
# Timezone (UTC by default per repo convention)
# =============================================================================
GOTIFY_TZ=UTC
