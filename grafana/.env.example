# Grafana Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update Grafana.
GRAFANA_VERSION=13.1.3

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the web UI (container port is always 3000)
GRAFANA_PORT=3000

# Admin account credentials.
# SERVER: Set a strong admin password — never deploy with the default.
ADMIN_USER=admin
ADMIN_PASSWORD=        # generate with: openssl rand -hex 16

# Allow anyone to create a user account on the sign-up page (default: false)
GRAFANA_ALLOW_SIGN_UP=false

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
GRAFANA_TZ=UTC
