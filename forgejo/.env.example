# Forgejo Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, fallback in compose is the exact tag
# (codeberg.org publishes only versioned tags, no `latest`).
# Bump this value and re-run `docker compose up -d` to update Forgejo.
FORGEJO_VERSION=16.0.2

# Database image — exact-pinned (never `latest`), so an accidental upgrade
# can't break the stack. Bump it deliberately, then re-run docker compose up -d.
POSTGRES_IMAGE=postgres:18.4-alpine3.23

# =============================================================================
# FORGEJO
# =============================================================================
# Host ports for the web UI and SSH (container ports are always 3000 and 22)
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=222

# UID/GID of the user that owns the Forgejo data volume on the host (default: 1000)
FORGEJO_UID=1000
FORGEJO_GID=1000

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=        # generate with: openssl rand -hex 32
POSTGRES_DB=forgejo

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
FORGEJO_TZ=UTC
