# .env.example
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# --- Forgejo ---
# UID/GID of the user that owns the Forgejo data volume on the host (default: 1000)
FORGEJO_UID=1000
FORGEJO_GID=1000

# Timezone used by the Forgejo container (UTC+0)
FORGEJO_TZ=UTC

# --- PostgreSQL ---
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=        # generate with: openssl rand -hex 32
POSTGRES_DB=forgejo
