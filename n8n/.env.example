# n8n Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGE (application — exact-pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
N8N_IMAGE=n8nio/n8n:2.34.4

# =============================================================================
# Core n8n settings
# =============================================================================
# Hostname used in the editor UI (and webhooks). SERVER: set to your domain
# (e.g. n8n.example.com) when exposing publicly.
N8N_HOST=localhost
# Protocol used by the editor UI — http locally, https behind TLS
N8N_PROTOCOL=http
# Port n8n listens on inside the container (fixed at 5678)
N8N_PORT=5678
# Publicly reachable webhook URL. SERVER: set to https://n8n.example.com
WEBHOOK_URL=http://localhost
# LOCAL: development mode. SERVER: set to production
N8N_NODE_ENV=dev

# =============================================================================
# Ports (host side; container port is fixed)
# =============================================================================
# Host port — bound to 127.0.0.1 by default (LOCAL). SERVER: change to the
# public port and/or bind to 0.0.0.0 behind a reverse proxy.
N8N_PORT_EXTERNAL=5678

# =============================================================================
# Timezone (UTC by default per repo convention)
# =============================================================================
N8N_TZ=UTC
