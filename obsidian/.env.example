# Obsidian Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update the image.
OBSIDIAN_VERSION=1.13.6

# =============================================================================
# APPLICATION
# =============================================================================
# Match these to your host user/group (run `id your_user` to find them)
PUID=1000
PGID=1000

# Timezone (default: UTC)
TZ=Etc/UTC

# Host port for the desktop GUI over HTTP (container port is fixed: 3000)
OBSIDIAN_HTTP_PORT=3000

# Host port for the desktop GUI over HTTPS (container port is fixed: 3001)
OBSIDIAN_HTTPS_PORT=3001

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Optional HTTP Basic auth — leave empty for no authentication (the image default).
# SERVER: Set both when exposing the container, or put it behind a reverse proxy
# with its own authentication. Generate a strong password with:
#   openssl rand -base64 18
OBSIDIAN_USER=
OBSIDIAN_PASSWORD=
