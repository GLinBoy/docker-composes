# Vaultwarden Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update the image.
# A smaller Alpine variant is available: vaultwarden/server:1.37.1-alpine
VAULTWARDEN_VERSION=1.37.1

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the Web vault (container port is fixed: 80)
VAULTWARDEN_PORT=8080

# Public URL of this instance — must match how browsers reach it (it is used in
# emails, invites and WebAuthn flows), e.g. https://vault.example.com
# SERVER: on a real server this MUST be your public https:// URL.
# Leave empty to fall back to http://localhost (local use only).
VAULTWARDEN_DOMAIN=

# =============================================================================
# ADMIN PANEL (optional)
# =============================================================================
# SERVER: token for the /admin panel — generate with: openssl rand -hex 32.
# Prefer an argon2 PHC string so no plain-text secret is stored (see README).
# Leave empty to disable the admin panel entirely.
ADMIN_TOKEN=

# =============================================================================
# SMTP (invites / password-reset mails)
# =============================================================================
# Only needed if you UNCOMMENT the SMTP block in docker-compose.yml.
# NOTE: setting these without enabling the block does nothing; and leaving
# the block enabled with empty SMTP_HOST/SMTP_FROM prevents startup.
SMTP_HOST=
SMTP_FROM=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=          # generate with: openssl rand -hex 32

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
TZ=UTC