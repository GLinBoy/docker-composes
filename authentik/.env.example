# authentik Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose
# Bump this value and re-run `docker compose up -d` to update the image
AUTHENTIK_VERSION=2026.5.6

# Dependency images (exact-pinned, never latest)
AUTHENTIK_POSTGRES_IMAGE=postgres:16-alpine
AUTHENTIK_REDIS_IMAGE=redis:7-alpine

# =============================================================================
# SECRETS (REQUIRED — fill these in)
# =============================================================================
# Secret key used by authentik to encrypt/sign data
# Generate with: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=

# PostgreSQL password (PostgreSQL supports at most 99 characters)
# Generate with: openssl rand -base64 36 | tr -d '\n'
PG_PASS=

# =============================================================================
# DATABASE
# =============================================================================
PG_USER=authentik
PG_DB=authentik

# =============================================================================
# PORTS (container ports are always 9000 HTTP / 9443 HTTPS)
# =============================================================================
AUTHENTIK_PORT_HTTP=9000
AUTHENTIK_PORT_HTTPS=9443

# =============================================================================
# OPTIONAL
# =============================================================================
# Log level: debug, info, warning, error
AUTHENTIK_LOG_LEVEL=info

# Send error reports to the authentik project: https://goauthentik.io/errors
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
# authentik requires UTC for OAuth/SAML — do NOT set this to a non-UTC value
AUTHENTIK_TZ=UTC
