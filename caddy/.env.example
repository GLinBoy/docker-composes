# Caddy Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# Application
# =============================================================================

# The exact Caddy version to deploy (e.g. 2.11.4-alpine) — compose defaults to `latest` when unset
# To update, bump this value to the next release, then re-run docker compose up -d
CADDY_VERSION=2.11.4-alpine

# Host ports for HTTP and HTTPS traffic (defaults: 80 / 443)
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Admin API address (default: localhost:2019)
CADDY_ADMIN=localhost:2019

# Grace period for graceful shutdown (default: 10s)
CADDY_GRACE_PERIOD=10s

# =============================================================================
# ACME / Let's Encrypt
# =============================================================================

# Set to true to agree to the ACME Terms of Service (required for Let's Encrypt)
ACME_AGREE=false

# Custom ACME CA URL (empty = Let's Encrypt)
# Useful for testing with a staging endpoint, e.g. https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=

# Email address for Let's Encrypt notifications
# SERVER: set to your real email before deploying to production
CADDY_EMAIL=
