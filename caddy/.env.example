# Caddy Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# --- Caddy Configuration ---
# CADDY_ADMIN=           # Admin API address (default: localhost:2019)
# CADDY_GRACE_PERIOD=    # Grace period for shutdown (default: 10s)

# --- ACME Configuration ---
# ACME_AGREE=true        # Set to true to agree to ACME TOS (required for Let's Encrypt)
# ACME_CA=               # Custom ACME CA URL (optional, defaults to Let's Encrypt)

# --- Email for Let's Encrypt ---
# CADDY_EMAIL=           # Your email address for Let's Encrypt notifications (recommended for production)
# SERVER: Set this to your actual email before deploying to production