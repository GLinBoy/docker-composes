# Cassandra Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# Application
# =============================================================================

# The exact Cassandra image to deploy — never `latest`
# To update, bump the exact value, then re-run docker compose up -d
CASSANDRA_IMAGE=cassandra:5.0.8

# Comma-separated list of seed nodes used by gossip when a node joins the cluster.
# cassandra-0 is the master/seed, cassandra-1 the first slave. When scaling up,
# add the new node's container name here on every node (see README "Scaling Up").
CASSANDRA_SEEDS=cassandra-0,cassandra-1

# Cluster name — MUST be identical on every node in the cluster
CASSANDRA_CLUSTER_NAME=Cassandra Cluster

# Datacenter and rack of this node
CASSANDRA_DC=datacenter1
CASSANDRA_RACK=rack1

# Host port for the CQL client port (default: 9042)
CASSANDRA_PORT=9042
