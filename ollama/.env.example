# Ollama + Open WebUI Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES (application — exact-pinned in .env, defaults to latest in compose)
# Bump a value and re-run `docker compose up -d` to update the image
# =============================================================================
OLLAMA_IMAGE=ollama/ollama:0.32.9
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.9.6

# =============================================================================
# PORTS (host side; container ports are fixed)
# =============================================================================
# Host port for the Ollama API (container port is fixed: 11434).
# Bound to 127.0.0.1 by default (LOCAL). SERVER: keep behind a reverse proxy or
# expose deliberately.
OLLAMA_PORT=11434
# Host port for the Open WebUI interface (container port is fixed: 8080)
OPEN_WEBUI_PORT=3000

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
TZ=Etc/UTC

# =============================================================================
# OPEN WEBUI
# =============================================================================
# Base URL for the Ollama API as seen from inside the stack. Leave as-is unless
# you point Open WebUI at an Ollama instance on another host.
OLLAMA_API_BASE_URL=http://ollama:11434/api
# Secret key used to sign Open WebUI sessions — generate with: openssl rand -hex 64
# If empty, Open WebUI generates an ephemeral key (sessions reset on restart).
WEBUI_SECRET_KEY=
