# Jenkins Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update the image.
JENKINS_VERSION=2.576-jdk25

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the Jenkins web UI (container port is fixed: 8080)
JENKINS_PORT=8080

# Host port for inbound build agents (JNLP, container port 50000).
# Keep the container port fixed; only change the host side if it collides.
JENKINS_AGENT_PORT=50000

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
JENKINS_TZ=UTC