# Duplicati Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose
# Bump this value and re-run `docker compose up -d` to update the image
DUPLICATI_VERSION=2.3.0.4

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the web UI (container port is always 8200)
DUPLICATI_PORT=8200

# User/group ID the container processes run as — set to your host user's id (`id -u` / `id -g`)
DUPLICATI_UID=1000
DUPLICATI_GID=1000

# Host path mounted as /source — what you want to back up (set to a real directory)
DUPLICATI_SOURCE_PATH=./source

# Host path mounted as /backups — where backups are stored (set to a real directory)
DUPLICATI_BACKUP_PATH=./backups

# Optional: Web UI login password (uncomment the line in docker-compose.yml to enable)
# Generate with: openssl rand -hex 32
DUPLICATI_WEBSERVICE_PASSWORD=

# Optional: Encrypts the config database (uncomment the line in docker-compose.yml to enable)
# Generate with: openssl rand -hex 32
DUPLICATI_SETTINGS_ENCRYPTION_KEY=

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
DUPLICATI_TZ=UTC
