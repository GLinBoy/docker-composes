# Heimdall Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update the image.
HEIMDALL_VERSION=2.8.1

# =============================================================================
# APPLICATION
# =============================================================================
# Host ports for the web UI (container ports are fixed: 80 http, 443 https)
HEIMDALL_HTTP_PORT=80
HEIMDALL_HTTPS_PORT=443

# By default Heimdall blocks lookup requests to private or reserved IP addresses.
# LOCAL: Set to true if Heimdall only serves your LAN or is behind auth.
# SERVER: Keep false if Heimdall is exposed to the internet.
ALLOW_INTERNAL_REQUESTS=false

# User/group ID the container processes run as — set to your host user's id (`id -u` / `id -g`)
PUID=1000
PGID=1000

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
HEIMDALL_TZ=UTC
