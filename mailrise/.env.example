# Mailrise Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# Application
# =============================================================================

# The exact Mailrise version to deploy (e.g. 1.3.0) — compose defaults to `latest` when unset
# To update, bump this value to the next release, then re-run docker compose up -d
MAILRISE_VERSION=1.3.0

# Host port for the SMTP server (default: 8025)
MAILRISE_PORT=8025

# Public domain used for the Traefik TLS certificate (optional, only if using Traefik)
# SERVER: set to your real domain (e.g. mail.example.com)
MAILRISE_DOMAIN=
