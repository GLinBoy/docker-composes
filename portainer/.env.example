# Portainer Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGE (application — exact-pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
PORTAINER_IMAGE=portainer/portainer-ce:2.43.0-alpine

# =============================================================================
# Ports
# =============================================================================
# Host port for the HTTP web UI (container port 9000 is fixed)
PORTAINER_PORT=9000

# Host port for the HTTPS web UI (container port 9443 — commented out in compose)
# PORTAINER_HTTPS_PORT=9443

# Host port for the Edge compute / agent tunnel (container port 8000 — commented out in compose)
# PORTAINER_EDGE_PORT=8000
