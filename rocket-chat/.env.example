# Rocket.Chat Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES (exact versions pinned in .env, defaults to latest in compose)
# Bump these values and re-run `docker compose up -d` to update the images
# =============================================================================
ROCKETCHAT_IMAGE=registry.rocket.chat/rocketchat/rocket.chat:8.7.1
MONGODB_IMAGE=mongodb/mongodb-community-server:8.2-ubi8

# =============================================================================
# Rocket.Chat Application
# =============================================================================
# Public URL users use to reach your workspace
ROOT_URL=http://localhost:3000
# Port Rocket.Chat listens on inside the container
PORT=3000
# Host port for Rocket.Chat (default: 3000)
ROCKETCHAT_PORT=3000
# IP the host port binds to (default: 0.0.0.0)
BIND_IP=0.0.0.0
# Optional registration token (auto-registers the workspace on first start)
REG_TOKEN=

# =============================================================================
# MongoDB
# =============================================================================
# UID of the mongodb user in the image (used for the /data/db ownership fix)
MONGODB_USER_ID=1001
# Host port for MongoDB (bound to 127.0.0.1 only; container port is fixed at 27017)
MONGODB_PORT=27017
# Replica set name used by Rocket.Chat (must match MONGO_URL if overridden)
MONGODB_REPLICA_SET_NAME=rs0
# Hostname advertised to replica set members (service name by default)
MONGODB_ADVERTISED_HOSTNAME=mongodb
# Optional: full MongoDB connection string override
# (default: mongodb://mongodb:27017/rocketchat?replicaSet=rs0)
MONGO_URL=

# =============================================================================
# Traefik (optional — only when routing through a Traefik reverse proxy)
# =============================================================================
# Public domain for the Rocket.Chat route (e.g. chat.example.com)
ROCKETCHAT_DOMAIN=
