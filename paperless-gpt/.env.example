# paperless-gpt Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGE (application — exact-pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
PAPERLESS_GPT_IMAGE=icereed/paperless-gpt:v0.27.0

# =============================================================================
# Ports
# =============================================================================
# Host port mapped to the container's web UI port 8080 (bound to 127.0.0.1 by
# default — paperless-gpt has no built-in authentication)
PAPERLESS_GPT_PORT=8080

# =============================================================================
# Timezone (UTC by default per repo convention)
# =============================================================================
PAPERLESS_GPT_TZ=UTC

# =============================================================================
# User / Group IDs (container runs as non-root)
# =============================================================================
# Find your UID/GID with `id -u` / `id -g`; must be non-zero
PUID=10001
PGID=10001

# =============================================================================
# Paperless-ngx connection (required)
# =============================================================================
# URL of your Paperless-ngx instance as seen from this container
# (e.g. http://paperless-ngx:8000 when both stacks share a network)
PAPERLESS_BASE_URL=http://paperless-ngx:8000
# API token generated in Paperless-ngx → Settings → API
PAPERLESS_API_TOKEN=
# Public URL of Paperless (only if it differs from PAPERLESS_BASE_URL)
PAPERLESS_PUBLIC_URL=

# =============================================================================
# Processing tags (created automatically in Paperless-ngx)
# =============================================================================
MANUAL_TAG=paperless-gpt
AUTO_TAG=paperless-gpt-auto
FAIL_TAG=paperless-gpt-failed

# =============================================================================
# LLM configuration (choose one provider)
# =============================================================================
# Provider: openai, ollama, googleai, mistral, or anthropic
LLM_PROVIDER=openai
# Model name (e.g. gpt-4o, qwen3:8b, claude-sonnet-4-5)
LLM_MODEL=gpt-4o
# OpenAI API key (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=
# Ollama server URL (required when LLM_PROVIDER=ollama)
OLLAMA_HOST=

# =============================================================================
# Optional settings
# =============================================================================
# Language used in prompts (e.g. English)
LLM_LANGUAGE=English
# OCR provider: llm, google_docai, azure, or docling
OCR_PROVIDER=llm
# Log level: info, debug, warn, error
LOG_LEVEL=info
