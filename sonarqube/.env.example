# SonarQube Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES (exact version pinned in .env, defaults to latest in compose)
# Bump these values and re-run `docker compose up -d` to update the images
# =============================================================================
# SonarQube Community Edition image tag
SONARQUBE_VERSION=26.8.0.126808-community
# PostgreSQL image tag (Alpine variant)
POSTGRES_IMAGE=postgres:16.2-alpine3.19

# =============================================================================
# DATABASE (shared between SonarQube and the PostgreSQL container)
# =============================================================================
# Name of the SonarQube database (default: sonar)
SONAR_DB_NAME=sonar
# Database user (default: sonar)
SONAR_DB_USER=sonar
# SERVER: set a strong password before exposing beyond localhost —
# generate with: openssl rand -hex 32
SONAR_DB_PASSWORD=

# =============================================================================
# PORTS (host side; container port is fixed)
# =============================================================================
# Host port for the SonarQube web UI (container port is fixed: 9000)
SONARQUBE_PORT=9001
