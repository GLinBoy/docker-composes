# Dashy Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update the image.
DASHY_VERSION=4.7.17

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the web UI (container port is fixed: 8080)
DASHY_PORT=8080

# =============================================================================
# AUTHENTICATION (OPTIONAL)
# =============================================================================
# Dashy's server endpoints are open by default. Set both values below to protect
# them with a single static login. Leave commented/empty to keep auth disabled.
# Generate a strong password with: openssl rand -hex 32
# BASIC_AUTH_USERNAME=       # e.g. admin
# BASIC_AUTH_PASSWORD=       # generate with: openssl rand -hex 32

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
DASHY_TZ=UTC
