# Transmission Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update the image.
TRANSMISSION_VERSION=4.1.3

# =============================================================================
# APPLICATION
# =============================================================================
# UID the daemon runs as — should match the owner of ./config ./downloads ./watch
PUID=1000
# GID the daemon runs as — should match the owner of ./config ./downloads ./watch
PGID=1000

# Host port for the Web UI / RPC interface (container port is fixed: 9091)
TRANSMISSION_RPC_PORT=9091

# Host port for peer traffic (TCP + UDP; container port is fixed: 51413).
# Keep identical to the port forwarded on your router.
TRANSMISSION_PEER_PORT=51413

# SERVER: Uncomment to require authentication on the Web UI / RPC
# (uncomment the USER/PASS lines in docker-compose.yml too)
# TRANSMISSION_USER=admin
# TRANSMISSION_PASSWORD=          # generate with: openssl rand -hex 16

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
TRANSMISSION_TZ=UTC