# CockroachDB Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# Application
# =============================================================================

# The exact CockroachDB image to deploy — never `latest`
# To update, bump the exact value, then re-run docker compose up -d
COCKROACHDB_IMAGE=cockroachdb/cockroach:v26.2.5

# Comma-separated list of nodes the cluster bootstraps/joins through.
# roach1 is the master/seed, roach2 the first slave. When scaling up, add the
# new node's host:port here on every node (see README "Scaling Up").
COCKROACHDB_JOIN=roach1:26357,roach2:26357

# Host ports for roach1 — SQL and DB Console
COCKROACHDB_SQL_PORT=26257
COCKROACHDB_HTTP_PORT=8080

# Host ports for roach2 — SQL and DB Console (offset to avoid conflicts)
COCKROACHDB_SQL_PORT_2=26258
COCKROACHDB_HTTP_PORT_2=8081
