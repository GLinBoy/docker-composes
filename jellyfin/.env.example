# Jellyfin Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update the image.
JELLYFIN_VERSION=10.11.11

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the web UI (container port is fixed: 8096)
JELLYFIN_PORT=8096

# Host port for clients to auto-discover the server (UDP, container port 7359).
# Remove the line if you don't use auto-discovery.
JELLYFIN_DLNA_PORT=7359

# User/group ID the container runs as — set to your host user's id (`id -u` / `id -g`)
# so Jellyfin can read the media bind mount below.
PUID=1000
PGID=1000

# Path to your media library on the host (mounted read-only at /media).
# Add more bind mounts in docker-compose.yml for additional libraries.
MEDIA_DIR=/path/to/media

# Optional — public URL clients use to autodiscover the server (e.g. https://jellyfin.example.com).
# Leave empty unless you need this.
JELLYFIN_PUBLISHED_SERVER_URL=

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
JELLYFIN_TZ=UTC