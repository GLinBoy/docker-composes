# Homer Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update the image.
HOMER_VERSION=v26.4.2

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the web UI (container port is fixed: 8080)
HOMER_PORT=8080

# Install the example configuration file & assets (favicons, ...) on first run
# to help you get started. Set to 0 to skip.
INIT_ASSETS=1

# Serve Homer under a subfolder, e.g. /homer. Keep "/" to serve at the root.
SUBFOLDER=/

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
HOMER_TZ=UTC
