# GitLab CE Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# Application
# =============================================================================

# The exact GitLab CE version to deploy (tag suffix) — compose defaults to `latest` when unset
# To update, bump this value to the next release, then re-run docker compose up -d
# See available tags: https://hub.docker.com/r/gitlab/gitlab-ce/tags
GITLAB_VERSION=19.2.1-ce.0

# Externally reachable URL of the GitLab instance (HTTP or HTTPS)
# SERVER: must be a real, reachable hostname — do not use localhost in production
GITLAB_EXTERNAL_URL=http://localhost

# Host port for HTTP (default: 80)
GITLAB_HTTP_PORT=80

# Host port for HTTPS (default: 443)
GITLAB_HTTPS_PORT=443

# Host port for SSH (default: 22). Must match the port shown in SSH clone URLs.
GITLAB_SSH_PORT=22

# =============================================================================
# Security
# =============================================================================

# Optional initial password for the `root` user — only applied on FIRST boot.
# If left empty, GitLab auto-generates one and stores it in
# /etc/gitlab/initial_root_password (auto-deleted after 24 hours).
# SERVER: generate with: openssl rand -base64 24 (minimum 8 characters)
GITLAB_ROOT_PASSWORD=

# =============================================================================
# Other
# =============================================================================

# Timezone (default: UTC per repo convention)
TZ=UTC
