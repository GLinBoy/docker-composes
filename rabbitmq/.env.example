# RabbitMQ Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGE (exact version pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
RABBITMQ_IMAGE=rabbitmq:4.3.4-management-alpine

# =============================================================================
# Credentials
# =============================================================================
# Default user created on first start (default: admin)
RABBITMQ_DEFAULT_USER=admin
# Password for the default user — generate with: openssl rand -hex 32
RABBITMQ_DEFAULT_PASS=

# =============================================================================
# Timezone (UTC by default per repo convention)
# =============================================================================
TZ=UTC

# =============================================================================
# Ports (host side; container port is fixed)
# =============================================================================
# AMQP protocol (client connections)
RABBITMQ_AMQP_PORT=5672
# Management web UI
RABBITMQ_MANAGEMENT_PORT=15672
# Erlang distribution / node and CLI communication
RABBITMQ_ERLANG_PORT=25672
