# Kong Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Kong application image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update the image.
KONG_VERSION=3.9.3

# PostgreSQL dependency image — exact-pinned fallback (never latest).
POSTGRES_IMAGE=postgres:16.15-alpine

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=kong         # e.g. kong
POSTGRES_PASSWORD=         # SERVER: strong value, e.g. openssl rand -hex 32
POSTGRES_DB=kong           # e.g. kong
POSTGRES_PORT=5432

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the Kong Admin API (container port is fixed: 8001)
KONG_ADMIN_PORT=8001
# Host port for the Kong proxy (container port is fixed: 8000)
KONG_PROXY_PORT=8000
# Host port for the Kong proxy TLS (container port is fixed: 8443)
KONG_PROXY_TLS_PORT=8443

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
KONG_TZ=UTC