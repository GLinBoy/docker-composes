# CouchDB Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# Application
# =============================================================================

# The exact CouchDB image to deploy — never `latest`
# To update, bump the exact value, then re-run docker compose up -d
COUCHDB_IMAGE=couchdb:3.5.2.1

# Host ports for the HTTP API — couchdb-0 and couchdb-1 (defaults: 5984 / 5985)
COUCHDB_PORT_0=5984
COUCHDB_PORT_1=5985

# =============================================================================
# Authentication & Clustering
# =============================================================================

# Admin username and password — password must match across all nodes
# SERVER: generate a strong password with: openssl rand -hex 24
COUCHDB_USER=admin
COUCHDB_PASSWORD=

# Cluster-wide shared secret — MUST be identical on every node in the cluster
# Generate with: openssl rand -hex 32
COUCHDB_SECRET=

# Erlang distribution cookie — MUST be identical on every node in the cluster
# Generate with: openssl rand -hex 32
COUCHDB_COOKIE=
