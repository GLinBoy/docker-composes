# Firefly III Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# Application
# =============================================================================

# The exact Firefly III version to deploy (e.g. version-6.6.6) — compose defaults to `latest` when unset
# To update, bump this value to the next release, then re-run docker compose up -d
FIREFLYIII_VERSION=version-6.6.6

# Exact dependency images — never `latest`
# To update, bump the exact value, then re-run docker compose up -d
FIREFLYIII_DATABASE_IMAGE=mariadb:12.3.2
FIREFLYIII_CRON_IMAGE=alpine:3.23

# Host port for the web UI (default: 8080)
FIREFLYIII_PORT=8080

# Public URL of the installation (used for links and CSRF)
APP_URL=http://localhost:8080

# App encryption key — a random string of EXACTLY 32 characters (A-Za-z0-9 only)
# Generate with: head /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 32 && echo
APP_KEY=

# Timezone (default: UTC)
TZ=Etc/UTC

# Comma-separated IPs or networks allowed to set X-Forwarded-* headers.
# SERVER: Replace ** with your reverse proxy's IP before deploying to production
TRUSTED_PROXIES=**

# Secret token for the cron service — a random string of EXACTLY 32 characters (A-Za-z0-9 only)
# Same generation command as APP_KEY above. Runs recurring transactions/bill reminders.
STATIC_CRON_TOKEN=

# =============================================================================
# Database
# =============================================================================

# Database name and user (defaults: firefly / firefly)
DB_DATABASE=firefly
DB_USERNAME=firefly

# Connection secret for the Firefly app — use alphanumeric characters only.
# This MUST match MARIADB_PASSWORD below. Generate with:
# head /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 24 && echo
DB_PASSWORD=

# Root password for the MariaDB server (backups, maintenance) — alphanumeric only
DB_ROOT_PASSWORD=
