# MinIO Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# Application
# =============================================================================

# MinIO root credentials — REQUIRED, must be at least 8 characters.
# Generate with: openssl rand -hex 16
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Host port for the S3 API (default: 9000)
MINIO_PORT=9000

# Host port for the web console (default: 9001)
MINIO_CONSOLE_PORT=9001

# Timezone (default: UTC)
TZ=Etc/UTC

# =============================================================================
# Exact images — never `latest`
# To update, bump the exact value, then re-run docker compose up -d
# =============================================================================

MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_NGINX_IMAGE=nginx:1.25.1-alpine
