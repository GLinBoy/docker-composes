# Gitea Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update Gitea.
GITEA_VERSION=1.27.1

# Database image — exact-pinned (never `latest`), so an accidental upgrade
# can't break the stack. Bump it deliberately, then re-run docker compose up -d.
POSTGRES_IMAGE=postgres:16.2-alpine3.19

# =============================================================================
# GITEA
# =============================================================================
# Host ports for the web UI and SSH (container ports are always 3000 and 22)
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=222

# UID/GID of the user that owns the Gitea data volume on the host (default: 1000)
GITEA_UID=1000
GITEA_GID=1000

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=gitea
POSTGRES_PASSWORD=        # generate with: openssl rand -hex 32
POSTGRES_DB=gitea

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
GITEA_TZ=UTC
