# LAMP Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# Application
# =============================================================================

# Tag for the locally-built PHP/Apache image (build context in this folder)
# To update, change the base image below, rebuild, and re-run docker compose up -d
LAMP_WEB_IMAGE=lamp-web:latest

# Base PHP/Apache image used by the Dockerfile build
LAMP_PHP_IMAGE=php:7.3-apache

# Host port for the Apache web server (default: 8080)
WEB_PORT=8080

# Timezone (default: UTC)
TZ=Etc/UTC

# =============================================================================
# Database
# =============================================================================

# Exact dependency images — never `latest`
# To update, bump the exact value, then re-run docker compose up -d
LAMP_MYSQL_IMAGE=mysql:8.1.0
LAMP_ADMINER_IMAGE=adminer:4.7.5

# Host port for MySQL (default: 3306)
MYSQL_PORT=3306

# Host port for Adminer (default: 8081)
ADMINER_PORT=8081

# Root password for the MySQL server — generate with: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=

# Database name and user for your PHP project
MYSQL_DATABASE=example
MYSQL_USER=devuser

# Password for MYSQL_USER — generate with: openssl rand -hex 32
MYSQL_PASSWORD=
