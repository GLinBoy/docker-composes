# Firefox Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update the image.
FIREFOX_VERSION=1153.0.3

# =============================================================================
# APPLICATION
# =============================================================================
# Host ports for the web UI (container ports are fixed: 3000 http, 3001 https)
FIREFOX_HTTP_PORT=3000
FIREFOX_HTTPS_PORT=3001

# User/group ID the container processes run as — set to your host user's id (`id -u` / `id -g`)
PUID=1000
PGID=1000

# Optional — Firefox CLI flags passed on launch (e.g. a homepage URL)
FIREFOX_CLI=https://google.com

# Optional — HTTP Basic auth for the web UI (uncomment the lines in docker-compose.yml to enable)
# Generate a strong password with: openssl rand -hex 16
FIREFOX_USER=
FIREFOX_PASSWORD=

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
FIREFOX_TZ=UTC
