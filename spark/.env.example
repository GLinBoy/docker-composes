# Apache Spark Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGE (exact version pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the cluster.
# All four services share the same image tag.
# =============================================================================
SPARK_IMAGE=apache/spark:4.2.0

# =============================================================================
# PORTS (host side; container ports are fixed)
# =============================================================================
# Host port for the Spark Master web UI (container port is fixed: 8080)
SPARK_UI_PORT=8080
# Host port for the Master RPC (container port is fixed: 7077).
# Workers always connect to the internal 7077; this only changes the host mapping.
SPARK_MASTER_PORT=7077

# =============================================================================
# WORKERS
# =============================================================================
# Memory and cores per worker container. Lower defaults keep local resource
# usage small — raise them for real workloads.
SPARK_WORKER_MEMORY=1G
SPARK_WORKER_CORES=1
