# WildFly Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Tag format: <version>-<jdk>, e.g. 41.0.0.Final-jdk25. The official floating
# tags (latest, latest-jdk25) are maintained too:
#   https://quay.io/repository/wildfly/wildfly
WILDFLY_IMAGE=quay.io/wildfly/wildfly:41.0.0.Final-jdk25

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the HTTP listener (container port is fixed: 8080)
WILDFLY_PORT=8080

# Host port for the management console (container port is fixed: 9990).
# NOTE: the stock image does NOT create an admin user and binds the management
# interface to localhost only — this port stays unreachable until you extend the
# image with an admin user and `-bmanagement 0.0.0.0` (see README).
WILDFLY_MANAGEMENT_PORT=9990

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
TZ=UTC