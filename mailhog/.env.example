# MailHog Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# Application
# =============================================================================

# The exact MailHog version to deploy (e.g. v1.0.1) — compose defaults to `latest` when unset
# To update, bump this value to the next release, then re-run docker compose up -d
MAILHOG_VERSION=v1.0.1

# Host port for the SMTP server (default: 1025)
MAILHOG_SMTP_PORT=1025

# Host port for the web UI / HTTP API (default: 8025)
MAILHOG_UI_PORT=8025
