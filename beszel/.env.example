# Beszel Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGE (application — exact-pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
BESZEL_IMAGE=henrygd/beszel:0.18.7

# =============================================================================
# Ports
# =============================================================================
# Host port mapped to the container's web UI port 8090
BESZEL_PORT=8090

# =============================================================================
# Timezone (UTC by default per repo convention)
# =============================================================================
BESZEL_TZ=UTC

# =============================================================================
# Application URL (used for alerts/notifications and OAuth redirects)
# =============================================================================
# Set to the URL you use to reach the Hub (e.g. https://beszel.example.com)
# BESZEL_APP_URL=http://localhost:8090
