# qBittorrent Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGE (exact version pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
QBITTORRENT_IMAGE=linuxserver/qbittorrent:5.2.3

# =============================================================================
# User / Group
# =============================================================================
# Host user ID and group ID for file ownership of /config and /downloads
# (find yours with `id -u` and `id -g`)
PUID=1000
PGID=1000

# =============================================================================
# Timezone (UTC by default per repo convention)
# =============================================================================
TZ=UTC

# =============================================================================
# Ports
# =============================================================================
# Container port the Web UI listens on (used by the healthcheck too)
WEBUI_PORT=8080
# Host port for the Web UI (default: 8080)
QBITTORRENT_WEBUI_PORT=8080
# Host port for the BitTorrent client, both TCP and UDP (default: 6881)
QBITTORRENT_BT_PORT=6881
