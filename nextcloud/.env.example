# Nextcloud All-in-One Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control - add it to .gitignore

# =============================================================================
# IMAGE (required - exact version to deploy)
# =============================================================================
# The AIO master container image tag. Pin an exact release here (never "latest").
# Find the newest release at: https://github.com/nextcloud/all-in-one/releases
NEXTCLOUD_AIO_VERSION=v13.4.0

# =============================================================================
# PORTS (optional)
# =============================================================================
# Host port for the HTTP redirect to Nextcloud (also used for the ACME http-challenge)
NEXTCLOUD_HTTP_PORT=80
# Host port for the AIO interface (self-signed certificate)
NEXTCLOUD_AIO_PORT=8080
# Host port for the AIO interface with a valid certificate (needs ports 80 + 8443 open)
NEXTCLOUD_HTTPS_PORT=8443

# =============================================================================
# TIMEZONE
# =============================================================================
TZ=Etc/UTC

# =============================================================================
# APACHE (optional)
# =============================================================================
# IP the Apache container binds to. Set to 127.0.0.1 when behind a reverse
# proxy that runs on the same host.
APACHE_IP_BINDING=0.0.0.0

# =============================================================================
# NEXTCLOUD DATA DIRECTORY (optional - MUST be set before the first start)
# =============================================================================
# Empty = Nextcloud data is stored in a Docker volume (default).
# Set to a host directory to store your files on the host, e.g. /data/nextcloud
# Warning: do not change this value after the initial installation!
NEXTCLOUD_DATADIR=
# Optional: allow the Nextcloud container to access additional host directories, e.g. /mnt/
NEXTCLOUD_MOUNT=

# =============================================================================
# LIMITS (optional)
# =============================================================================
# Max public upload size (must start with a number and end with G, e.g. 16G)
NEXTCLOUD_UPLOAD_LIMIT=16G
# Max execution time for uploads in seconds
NEXTCLOUD_MAX_TIME=3600
# PHP memory limit per process in the Nextcloud container
NEXTCLOUD_MEMORY_LIMIT=512M

# =============================================================================
# LOGGING (optional)
# =============================================================================
# AIO log level: debug, info, warn, error. Empty = default.
AIO_LOG_LEVEL=
