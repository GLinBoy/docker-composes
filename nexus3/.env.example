# Nexus3 Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGE (exact version pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
NEXUS_IMAGE=sonatype/nexus3:3.95.0

# =============================================================================
# PORTS (host side; container ports are fixed)
# =============================================================================
# Host port for the Nexus web UI (container port is fixed: 8081)
NEXUS_HTTP_PORT=8081
# Host port for a Docker hosted repository (container port 8085).
# Only needed if you create a Docker hosted repo — remove the mapping otherwise.
NEXUS_DOCKER_PORT=8085

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
NEXUS_TZ=UTC
