# Immich Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# Storage locations
# =============================================================================

# The location where your uploaded files are stored
UPLOAD_LOCATION=./library

# The location where your database files are stored
# Network shares are not supported for the database
DB_DATA_LOCATION=./postgres

# =============================================================================
# Application
# =============================================================================

# Timezone (default: UTC)
TZ=Etc/UTC

# The exact Immich version to deploy (e.g. v3.1.0) — compose defaults to `latest` when unset
# To update, bump this value to the next release, then re-run docker compose up -d
IMMICH_VERSION=v3.1.0

# Exact dependency images — release-locked to IMMICH_VERSION above.
# Do NOT bump these independently: when upgrading Immich, take the matching pins
# from that release's official docker-compose.yml.
IMMICH_DATABASE_IMAGE=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23
IMMICH_REDIS_IMAGE=docker.io/valkey/valkey:9@sha256:8e8d64b405ce18f41b8e5ee20aa4687a8ed0022d1298f2ce31cdcf3a76e09411

# Host port for the web UI (default: 2283)
IMMICH_PORT=2283

# =============================================================================
# Database
# =============================================================================

# Connection secret for postgres — generate with: openssl rand -hex 32
# Please use only the characters A-Za-z0-9 (no special characters or spaces)
DB_PASSWORD=

# The values below this line do not need to be changed
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
