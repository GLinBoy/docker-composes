# changedetection.io Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose
# Bump this value and re-run `docker compose up -d` to update the image
CHANGEDETECTION_IMAGE=ghcr.io/dgtlmoon/changedetection.io:0.55.8

# Chrome/JS fetcher image (dependency — exact-pinned, never latest)
SOCKPUPPET_IMAGE=dgtlmoon/sockpuppetbrowser:0.0.3

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the web UI (container port is always 5000)
CHANGEDETECTION_PORT=5000

# Public base URL of this install (no trailing slash), used in notification links
# Example: BASE_URL=https://changedetection.example.com
BASE_URL=

# Chrome/JS rendering via the sockpuppetbrowser service (default enabled)
# Set empty to disable JS rendering and only use the plain HTTP fetcher
PLAYWRIGHT_DRIVER_URL=ws://browser-sockpuppet-chrome:3000

# Number of parallel/concurrent fetchers
FETCH_WORKERS=10

# Log output levels: TRACE, DEBUG (default), INFO, SUCCESS, WARNING, ERROR, CRITICAL
LOGGER_LEVEL=INFO

# =============================================================================
# BROWSER (sockpuppetbrowser)
# =============================================================================
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1024
SCREEN_DEPTH=16
MAX_CONCURRENT_CHROME_PROCESSES=10

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
CHANGEDETECTION_TZ=UTC
