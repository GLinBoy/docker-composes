# Linkwarden Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# Application
# =============================================================================

# The exact Linkwarden version to deploy (e.g. v2.16.1) — compose defaults to `latest` when unset
# To update, bump this value to the next release, then re-run docker compose up -d
LINKWARDEN_VERSION=latest

# Host port for the web UI (default: 3000)
LINKWARDEN_PORT=3000

# Public URL of the app used by NextAuth (must match the port above when changed)
NEXTAUTH_URL=http://localhost:3000/api/v1/auth

# NextAuth encryption secret — REQUIRED
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# =============================================================================
# Database
# =============================================================================

# Connection secret for postgres — generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# The values below this line do not need to be changed
POSTGRES_USER=postgres
POSTGRES_DB=postgres

# =============================================================================
# Meilisearch (full-text search)
# =============================================================================

# Master key for Meilisearch — REQUIRED, used by both Meilisearch and Linkwarden.
# Generate with: openssl rand -hex 32
MEILI_MASTER_KEY=

# =============================================================================
# Exact dependency images — never `latest`
# To update, bump the exact value, then re-run docker compose up -d
# =============================================================================

LINKWARDEN_POSTGRES_IMAGE=postgres:16-alpine
LINKWARDEN_MEILI_IMAGE=getmeili/meilisearch:v1.12.8
