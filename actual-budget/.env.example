# Actual Budget Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# Application
# =============================================================================

# The exact Actual Budget version to deploy (tag suffix) — compose defaults to `latest` when unset
# To update, bump this value to the next release, then re-run docker compose up -d
ACTUAL_VERSION=26.8.1-alpine

# Host port for the web UI (default: 5006)
ACTUAL_PORT=5006

# Maximum allowed size for sync files in MB (default: 20)
ACTUAL_UPLOAD_FILE_SYNC_SIZE_LIMIT_MB=20

# Timezone (default: UTC per repo convention)
TZ=UTC

# =============================================================================
# Optional: HTTPS termination directly in the container
# (not needed when terminating TLS at a reverse proxy)
# =============================================================================
# Place selfhost.key and selfhost.crt in the data folder, then uncomment the
# ACTUAL_HTTPS_* lines in docker-compose.yml and set them here:
# ACTUAL_HTTPS_KEY=/data/selfhost.key
# ACTUAL_HTTPS_CERT=/data/selfhost.crt
