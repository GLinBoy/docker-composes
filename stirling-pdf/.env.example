# Stirling PDF Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGE (exact version pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
STIRLING_PDF_IMAGE=stirlingtools/stirling-pdf:2.14.3

# =============================================================================
# PORTS (host side; container port is fixed)
# =============================================================================
# Host port for the web UI (container port is fixed: 8080)
STIRLING_PDF_PORT=8080

# =============================================================================
# SECURITY
# =============================================================================
# Require login before using the app. The first account created on the login
# page becomes the admin. Keep true when exposed beyond localhost.
SECURITY_ENABLELOGIN=true

# =============================================================================
# SYSTEM
# =============================================================================
# Default OCR language (comma-separated for multiple, e.g. en_GB,fr_FR)
LANGS=en_GB
# Default UI locale
SYSTEM_DEFAULTLOCALE=en-GB
# Allow the app to be indexed by search engines. Set to false when public.
SYSTEM_GOOGLEVISIBILITY=false
# Maximum PDF upload size in MB (0 = unlimited)
SYSTEM_MAXFILESIZE=2000
