# WUD (What's Up Docker) Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update the image:
#   https://hub.docker.com/r/getwud/wud/tags
WUD_IMAGE=getwud/wud:8.3.1

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the web UI / REST API (container port is fixed: 3000)
WUD_PORT=3000

# Log verbosity: debug, info, warn, error
WUD_LOG_LEVEL=info

# Notes:
# - WUD needs the Docker socket (already mounted in docker-compose.yml).
# - Additional WUD_* settings (registries, triggers, auth, watchers) can be
#   added here — see https://getwud.github.io/wud/docs/configuration/
# - Per-container tuning is done with `wud.*` labels on the monitored services.

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
TZ=UTC