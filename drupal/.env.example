# Drupal Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Drupal app image — exact-pinned in .env, defaults to a stable fpm-alpine tag in compose
# (NOT latest: the apache-based `latest` tag would not match this nginx + fpm setup)
DRUPAL_VERSION=11.3.10-fpm-alpine3.23

# Dependency images — exact-pinned, never latest
MYSQL_IMAGE=mysql:8.0.34
NGINX_IMAGE=nginx:1.25.2-alpine-slim
CERTBOT_IMAGE=certbot/certbot:v2.6.0

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the web UI (container port is always 80)
DRUPAL_PORT=80

# =============================================================================
# DATABASE
# =============================================================================
# Generate passwords with: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=drupal
MYSQL_USER=drupal
MYSQL_PASSWORD=

# =============================================================================
# TLS / CERTBOT
# =============================================================================
# SERVER: Set to your real email address
CERTBOT_EMAIL=

# SERVER: Set to your real domain (e.g. drupal.example.com) and update
#         server_name in data/nginx-data/nginx.conf accordingly
CERTBOT_DOMAIN=localhost

# SERVER: Set to empty ("") to issue real certificates instead of Let's Encrypt staging certs
CERTBOT_STAGING_FLAG=--staging

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
DRUPAL_TZ=UTC
