# Apache Flink Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Bump this value and re-run `docker compose up -d` to update the cluster.
FLINK_VERSION=2.3.0

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the Flink Web UI (container port is always 8081)
FLINK_UI_PORT=8081

# Host port for the JobManager RPC (container port is always 6123)
FLINK_JOBMANAGER_RPC_PORT=6123
