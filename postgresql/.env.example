# PostgreSQL Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGE (exact version pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
POSTGRES_IMAGE=postgres:18.4-alpine3.23

# =============================================================================
# Credentials
# =============================================================================
# SERVER: set a strong password before exposing beyond localhost —
# generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Superuser created automatically on first start (default: postgres)
POSTGRES_USER=postgres
# Default database created automatically on first start (default: postgres)
POSTGRES_DB=postgres

# =============================================================================
# Ports (host side; container port is fixed)
# =============================================================================
POSTGRES_PORT=5432

# =============================================================================
# Timezone (UTC by default per repo convention)
# =============================================================================
POSTGRES_TZ=UTC
