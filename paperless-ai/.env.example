# Paperless-AI Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGE (application — exact-pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
PAPERLESS_AI_IMAGE=clusterzx/paperless-ai:3.0.9

# =============================================================================
# Ports
# =============================================================================
# Host port mapped to the container's web UI port 3000
PAPERLESS_AI_PORT=3000

# =============================================================================
# Timezone (UTC by default per repo convention)
# =============================================================================
PAPERLESS_AI_TZ=UTC

# =============================================================================
# RAG service (runs inside the same container)
# =============================================================================
# URL of the built-in RAG service (semantic search / AI chat backend)
PAPERLESS_AI_RAG_SERVICE_URL=http://localhost:8000
# Enable or disable the RAG service
PAPERLESS_AI_RAG_SERVICE_ENABLED=true
