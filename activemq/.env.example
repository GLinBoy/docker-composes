# ActiveMQ Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGE (application — exact-pinned in .env, defaults to latest in compose)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
ACTIVEMQ_IMAGE=apache/activemq:6.3.0

# =============================================================================
# Web Console Credentials (http://localhost:8161)
# Defaults to admin/admin when left unset. SERVER: set a strong password before
# exposing beyond localhost — generate with: openssl rand -hex 32
# =============================================================================
ACTIVEMQ_WEB_USER=admin
ACTIVEMQ_WEB_PASSWORD=

# =============================================================================
# Ports (host side; container ports are fixed)
# =============================================================================
# OpenWire (TCP) — Java/JMS clients
ACTIVEMQ_PORT_OPENWIRE=61616
# STOMP
ACTIVEMQ_PORT_STOMP=61613
# MQTT
ACTIVEMQ_PORT_MQTT=1883
# AMQP 1.0
ACTIVEMQ_PORT_AMQP=5672
# Web Console (HTTP)
ACTIVEMQ_PORT_WEB=8161
# JMX RMI Registry (inert unless JMX security is enabled — see README)
ACTIVEMQ_PORT_JMX=1099

# =============================================================================
# Timezone (UTC by default per repo convention)
# =============================================================================
ACTIVEMQ_TZ=UTC
