# Komodo Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Exact image tags to deploy — compose falls back to `latest` when unset.
# Bump the value and re-run `docker compose up -d` to update:
#   Core / Periphery: https://github.com/moghtech/komodo/pkgs/container/komodo-core
#   Mongo:            https://hub.docker.com/_/mongo
# Keep CORE and PERIPHERY on the same Komodo release. Mongo has no Alpine
# variant; 8.0 is the current LTS line (8.2.x / 8.3.x rapid releases exist).
KOMODO_CORE_IMAGE=ghcr.io/moghtech/komodo-core:2.3.2
KOMODO_PERIPHERY_IMAGE=ghcr.io/moghtech/komodo-periphery:2.3.2
MONGO_IMAGE=mongo:8.0.29

# =============================================================================
# KOMODO CORE (UI / API)
# =============================================================================
# Host port for the web UI / API (container port is fixed: 9120)
KOMODO_PORT=9120

# MongoDB root credentials used by Core (mongo service)
# SERVER: Set a strong password — generate with: openssl rand -hex 32
# NOTE: Only applied on FIRST start (empty mongo_data volume). To change it
#       later, update the user inside MongoDB or recreate the volume.
KOMODO_DB_USERNAME=admin
KOMODO_DB_PASSWORD=

# Shared secret that authenticates Core <-> Periphery connections
# SERVER: Set a strong passkey — generate with: openssl rand -hex 32
# Without it, Periphery accepts unauthenticated connections.
KOMODO_PASSKEY=

# Secrets used by Core — generate with: openssl rand -hex 32
# SERVER: Set both before exposing Komodo beyond localhost
KOMODO_JWT_SECRET=
KOMODO_WEBHOOK_SECRET=

# Initial admin account created on first launch.
# Leave commented to skip auto-creation and register the first user via the
# signup button in the UI instead.
#KOMODO_INIT_ADMIN_USERNAME=admin
#KOMODO_INIT_ADMIN_PASSWORD=

# Host path where dated database backups are written
# https://komo.do/docs/setup/backup
KOMODO_BACKUPS_PATH=/etc/komodo/backups

# Public URL used for OAuth callbacks / webhook suggestions / reverse proxy
#KOMODO_HOST=https://komodo.example.com

# =============================================================================
# KOMODO PERIPHERY (agent)
# =============================================================================
# Agent root directory — MUST be the same path inside and outside the container
# https://github.com/moghtech/komodo/discussions/180
PERIPHERY_ROOT_DIRECTORY=/etc/komodo

# SSL with self-signed certificates for the Periphery agent port (8120)
PERIPHERY_SSL_ENABLED=true

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
TZ=UTC

# =============================================================================
# OPTIONAL — EXTRA CORE / PERIPHERY CONFIG
# =============================================================================
# This compose file passes the whole .env file to the core and periphery
# containers (env_file), so any KOMODO_* / PERIPHERY_* variable can be added
# directly here. Full variable lists:
#   Core:      https://github.com/moghtech/komodo/blob/main/config/core.config.toml
#   Periphery: https://github.com/moghtech/komodo/blob/main/config/periphery.config.toml
#
# Examples:
#   # Server polling rate (1-sec, 5-sec, 15-sec, 1-min, 5-min, 15-min)
#   KOMODO_MONITORING_INTERVAL=15-sec
#   # The "first server" registered in Core on initial startup
#   KOMODO_FIRST_SERVER=https://periphery:8120
#   KOMODO_FIRST_SERVER_NAME=Local
#   # Disable new user signups
#   KOMODO_DISABLE_USER_REGISTRATION=true
#   # Fix overreported disk sizes (comma separated paths)
#   PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
