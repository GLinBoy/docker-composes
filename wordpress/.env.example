# WordPress Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — it is listed in .gitignore

# =============================================================================
# IMAGES
# =============================================================================
# Application image — exact-pinned in .env, defaults to latest in compose.
# Variants: apache (default — serves HTTP on 80), fpm / fpm-alpine (FastCGI only,
# needs a separate web server), cli. Bump this value and re-run `docker compose
# up -d` to update the image:
#   https://hub.docker.com/_/wordpress
WORDPRESS_IMAGE=wordpress:7.0.4-php8.3-apache

# Exact dependency image — never `latest` (MariaDB 11.4 is the LTS line; 11.8 is the
# latest short-term release — either works with WordPress)
MARIADB_IMAGE=mariadb:11.8.8

# =============================================================================
# APPLICATION
# =============================================================================
# Host port for the web UI (container port is fixed: 80)
WORDPRESS_PORT=80

# Database name and user used by the WordPress app
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress

# Connection password for the app — REQUIRED, the app halts without it.
# Generate with: openssl rand -hex 32
WORDPRESS_DB_PASSWORD=

# =============================================================================
# DATABASE
# =============================================================================
# Root password for the MariaDB server (backups, maintenance) — REQUIRED.
# Generate with: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=

# =============================================================================
# TIMEZONE (UTC by default per repo convention)
# =============================================================================
TZ=UTC