# Apache Artemis Docker Compose - Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# Never commit .env to version control — add it to .gitignore

# =============================================================================
# IMAGE (dependency — exact-pinned)
# Bump this value and re-run `docker compose up -d` to update the image
# =============================================================================
ARTEMIS_IMAGE=apache/artemis:2.55.0-alpine

# =============================================================================
# Ports (all protocol ports exposed on the host)
# =============================================================================
ARTEMIS_PORT_CORE=61616 # Core Protocol (TCP)
ARTEMIS_PORT_STOMP=61613 # STOMP
ARTEMIS_PORT_MQTT=1883 # MQTT
ARTEMIS_PORT_AMQP=5672 # AMQP
ARTEMIS_PORT_HTTP=8161 # Web Console (HTTP)
ARTEMIS_PORT_JMX=1099 # JMX RMI Registry Port

# =============================================================================
# Timezone (UTC by default per repo convention)
# =============================================================================
ARTEMIS_TZ=UTC

# =============================================================================
# Admin credentials (used to create the broker instance on first start)
# =============================================================================
# SERVER: replace the weak default with a strong password
# (openssl rand -hex 32) before exposing beyond localhost.
# ARTEMIS_USER=artemis
# ARTEMIS_PASSWORD=artemis

# =============================================================================
# Anonymous login (allow clients to connect without credentials)
# =============================================================================
ARTEMIS_ANONYMOUS_LOGIN=false
